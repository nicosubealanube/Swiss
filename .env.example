# ============================================================================
# CONFIGURACIÓN DE CASILLA DE CORREO Y SHAREPOINT (Microsoft 365 / Graph API)
# ============================================================================

# Casilla objetivo a monitorear
TARGET_MAILBOX=ABM.Convenios@swissmedical.com.ar

# Credenciales de Azure AD (App Registration) para Microsoft Graph API
# Permite leer la bandeja de entrada de ABM.Convenios y escribir en el Excel de SharePoint
AZURE_TENANT_ID=tu-tenant-id
AZURE_CLIENT_ID=tu-client-id
AZURE_CLIENT_SECRET=tu-client-secret

# Alternativa IMAP (si se usa conexión IMAP en lugar de Graph API)
IMAP_SERVER=outlook.office365.com
IMAP_USER=ABM.Convenios@swissmedical.com.ar
IMAP_PASSWORD=

# Configuración del archivo Excel en SharePoint (para Microsoft Graph API)
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_ITEM_ID=
SHAREPOINT_TABLE_NAME=TablaExcepciones

# Ruta local del archivo Excel (para pruebas locales o carpeta sincronizada con OneDrive/SharePoint)
LOCAL_EXCEL_PATH=output/excepciones_abm.xlsx
INITIAL_INGRESO_NUMBER=50607

# Valores por defecto
DEFAULT_GERENCIA_AUTORIZANTE=Gerencia de Gestión de Prestadores Interior
DEFAULT_USUARIO_CARGA=
